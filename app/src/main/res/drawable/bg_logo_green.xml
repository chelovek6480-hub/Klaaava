<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/logo_fill" />
            <stroke
                android:width="3dp"
                android:color="@color/logo_glow" />
            <corners android:radius="32dp" />
        </shape>
    </item>

    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/logo_fill" />
            <stroke
                android:width="2dp"
                android:color="@color/accent_green" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
